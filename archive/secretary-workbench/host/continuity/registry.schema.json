{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-owned continuity registry; runtime validation remains authoritative",
  "type": "object",
  "required": [
    "ownerThread",
    "bindings"
  ],
  "properties": {
    "ownerThread": {
      "type": "string",
      "format": "uuid"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "account",
          "peer",
          "threadId",
          "historyThreadId",
          "cwd",
          "workEntry",
          "since",
          "handledSources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "peer": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "historyThreadId": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "workEntry": {
            "type": "string"
          },
          "workRoot": {
            "type": "string"
          },
          "workbookDir": {
            "type": "string"
          },
          "automationId": {
            "type": "string"
          },
          "triggerMode": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "since": {
            "type": "integer",
            "minimum": 1
          },
          "handledSources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownerTextAliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "description": "An empty template is intentionally unready. Actual parser also validates private ownership, paths, aliases, accounts and immutable source identities."
}
