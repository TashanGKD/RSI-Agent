WECHAT_ACCOUNT_ID=wxid_fixture_operator
WECHAT_MAC_ACCOUNT_ID=wxid_fixture_owner
WECHAT_MAC_FOUNDATION=/absolute/separately-provided/mac-foundation
WECHAT_OCR_ROOT=/usr/share/tesseract-ocr/5
WECHAT_OCR_RUNTIME=/absolute/private/ocr-runtime
