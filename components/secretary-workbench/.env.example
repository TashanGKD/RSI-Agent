SECRETARY_MAIL_KEYCHAIN_SERVICE=org.example.secretary.mail163.imap
WECHAT_SSH_HOST=secretary-wechat-host
WECHAT_REMOTE_CODE_ROOT=/opt/secretary-workbench/wechat
