[Unit]
Description=Private WeChat X and VNC server
PartOf=wechat-gui.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=wechat-gui
Group=wechat-gui
UMask=0077
RuntimeDirectory=wechat-gui
RuntimeDirectoryMode=0700
Environment=HOME=/home/wechat-gui XDG_RUNTIME_DIR=/run/wechat-gui
ExecStartPre=/usr/bin/python3 @RELEASE@/deploy/wechat-gui/prepare_runtime.py prepare --root /run/wechat-gui --display :92
ExecStart=/usr/bin/Xtigervnc :92 -geometry 1280x800 -depth 24 -rfbport -1 -rfbunixpath /run/wechat-gui/vnc.sock -rfbunixmode 0600 -SecurityTypes None -localhost -nolisten tcp -auth /run/wechat-gui/Xauthority
ExecStartPost=/usr/bin/python3 @RELEASE@/deploy/wechat-gui/prepare_runtime.py wait --root /run/wechat-gui --display :92
TimeoutStartSec=30
Restart=on-failure
RestartSec=3
